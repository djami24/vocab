rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Pul mukofoti maydonlari (earnings): bitta yozishda lifetimeEarned,
    // cashWithdrawn va tuitionWithdrawn hech qachon PASAYMASLIGI kerak —
    // bu klient tomonidan tasodifan yoki qasddan "chiqarilgan pul"
    // tarixini yashirib qo'yishning oldini oladi. DIQQAT: bu — faqat
    // qo'shimcha himoya qatlami; bu loyihada backend (Cloud Functions)
    // yo'qligi sababli, balansni o'zi yuqoriga "soxta" oshirishning
    // oldini bu qoidalar bilan to'liq olib bo'lmaydi (buning uchun
    // so'z qo'shish/pul chiqarish amallari server tomonida
    // tasdiqlanishi kerak bo'lardi).
    function earningsOk() {
      return !('earnings' in request.resource.data) ||
        !('earnings' in resource.data) ||
        (
          request.resource.data.earnings.lifetimeEarned >= resource.data.earnings.lifetimeEarned &&
          request.resource.data.earnings.cashWithdrawn >= resource.data.earnings.cashWithdrawn &&
          request.resource.data.earnings.tuitionWithdrawn >= resource.data.earnings.tuitionWithdrawn
        );
    }

    // Har bir foydalanuvchi FAQAT o'z hujjatini yoza oladi (progress,
    // faollik, bayroqlar, pul mukofoti). O'qishni esa o'zi VA istalgan
    // admin amalga oshira oladi (Admin panelidagi "Foydalanuvchilar" va
    // "Pul mukofoti" ro'yxatlari uchun).
    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId && earningsOk();
    }

    // Admin ro'yxati: har kim faqat OʻZINING holatini oʻqiy oladi
    // (dasturda "isAdmin()" tekshiruvi uchun), admin esa hammasini
    // oʻqib chiqa oladi. Yozish FAQAT mavjud adminlarga ruxsat —
    // shuning uchun ENG BIRINCHI admin hujjati Firebase Console
    // orqali qoʻlda yaratilishi kerak (pastdagi yoʻriqnomaga qarang).
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Darajalar (levels): admin panelidan qo'shiladigan QO'SHIMCHA darajalar
    // (Beginner...Upper-Intermediate 5 ta tayyor daraja koddagi statik
    // fayllarda saqlanadi va bu yerga tegishli emas). O'qish HAMMAGA ochiq
    // — chunki statik data/*.json fayllar ham hech qanday autentifikatsiyasiz
    // ochiq o'qiladi, shu bilan bir xillik saqlanadi. Yozish faqat adminga.
    match /levels/{levelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Har bir (admin qo'shgan) darajaning so'zlari — hujjat ID darajaning
    // o'zi bilan bir xil. Struktura: { words: [ {en, uz, example, ipa}, ... ] }.
    // O'qish HAMMAGA ochiq (yuqoridagi /levels/ bilan bir xil sabab).
    // Yozish faqat adminga — talaba so'zlar ro'yxatini o'zgartira olmaydi.
    match /levelWords/{levelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // IELTS va CEFR sotib olish holati (HAR BIRI ALOHIDA) — hujjat ID
    // formati: `${uid}_${track}` (masalan "abc123_ielts", "abc123_cefr").
    // Har bir foydalanuvchi FAQAT o'zining hujjatini o'qiy oladi, admin —
    // hammasini. Faollashtirish (yozish) FAQAT adminga tegishli.
    match /examPurchases/{id} {
      allow read: if request.auth != null &&
        (isAdmin() || resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // Sotib olish so'rovlari: foydalanuvchi FAQAT o'zi nomidan (va o'zi
    // yozayotgan uid bilan) so'rov yarata oladi, o'qish/o'zgartirish/
    // o'chirish esa faqat adminga (so'rovlarni ko'rib chiqish uchun).
    match /examPurchaseRequests/{id} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read, update, delete: if isAdmin();
    }

    // IELTS/CEFR mavzulari (topics): O'qish faqat SHU ANIQ bo'limni (track)
    // sotib olgan (yoki admin) foydalanuvchilarga — chunki IELTS va CEFR
    // bir-biridan mustaqil pullik bo'limlar. Yozish faqat adminga.
    match /examTopics/{topicId} {
      allow read: if request.auth != null &&
        (isAdmin() ||
         (exists(/databases/$(database)/documents/examPurchases/$(request.auth.uid + '_' + resource.data.track)) &&
          get(/databases/$(database)/documents/examPurchases/$(request.auth.uid + '_' + resource.data.track)).data.active == true));
      allow write: if isAdmin();
    }

    // Har bir mavzuning so'zlari — struktura levelWords bilan bir xil:
    // { words: [ {en, uz, example, ipa}, ... ] }. Bu hujjatning o'zida
    // `track` maydoni yo'q, shuning uchun tegishli examTopics hujjatidan
    // o'qiladi (hujjat ID bir xil — topicId).
    match /examTopicWords/{topicId} {
      allow read: if request.auth != null &&
        (isAdmin() ||
         (exists(/databases/$(database)/documents/examTopics/$(topicId)) &&
          exists(/databases/$(database)/documents/examPurchases/$(request.auth.uid + '_' + get(/databases/$(database)/documents/examTopics/$(topicId)).data.track)) &&
          get(/databases/$(database)/documents/examPurchases/$(request.auth.uid + '_' + get(/databases/$(database)/documents/examTopics/$(topicId)).data.track)).data.active == true));
      allow write: if isAdmin();
    }

    // Sayt sozlamalari (bosh sahifa matnlari): hatto tizimga
    // kirmagan mehmon ham bosh sahifani ochganda o'qiy olishi kerak
    // — shuning uchun ochiq o'qish. Yozish faqat adminga.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Faollik jurnali (kirish/chiqish/ro'yxatdan o'tish): har bir
    // foydalanuvchi FAQAT o'zi haqidagi yozuvni qo'sha oladi (uid
    // mos kelishi shart) — boshqa birovning nomidan yozib bo'lmaydi.
    // O'qish va o'chirish faqat adminga.
    match /activityLog/{logId} {
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Reyting (leaderboard): har bir foydalanuvchi FAQAT o'zining
    // xulosa hujjatini (ism, o'rgangan so'zlar soni, joriy daraja,
    // yutuqlar soni) yoza oladi — boshqa birovning natijasini
    // o'zgartira olmaydi. O'qish HAMMAGA ochiq (tizimga kirmagan
    // mehmonlarga ham) — chunki qisqa reyting bosh sahifada ko'rinadi.
    // Bu yerda email yoki boshqa shaxsiy ma'lumot SAQLANMAYDI — faqat
    // ism va sonlar.
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
